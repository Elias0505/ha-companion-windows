<Project>

  <!--
    Shared MSBuild properties for all projects in HA Companion for Windows.
    SPDX-License-Identifier: AGPL-3.0-only
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Strict build: every warning is an error, .NET analyzers at the recommended level.
         Style rules (IDExxxx) stay out of the build — correctness only. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Deliberate exemptions:
         CA1848 — LoggerMessage source-gen is pure perf noise for a tray app.
         CA1031 — best-effort catch-alls are a design pattern here (each commented).
         CA2007 — Core is consumed from UI code; blanket ConfigureAwait noise. -->
    <NoWarn>$(NoWarn);CA1848;CA1031;CA2007</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Committed lockfiles + locked restore in CI: the runner can only ever
         resolve exactly what was reviewed here. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Package / authorship metadata (single source of truth) -->
  <PropertyGroup>
    <Product>HA Companion for Windows</Product>
    <Authors>Elias0505</Authors>
    <Company>Elias0505</Company>
    <Copyright>Copyright (C) 2026 Elias0505</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Elias0505/ha-companion-windows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.4.6</Version>
  </PropertyGroup>

</Project>
