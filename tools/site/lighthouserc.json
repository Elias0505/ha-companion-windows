{
  "ci": {
    "collect": {
      "staticDistDir": "./site",
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": [
          "uses-http2",
          "bf-cache"
        ],
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu"
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/imprint.html",
        "http://localhost/privacy.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.99
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.005
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 400000
          }
        ]
      }
    }
  }
}
