# Normalize line endings: repo stores LF, checks out native.
* text=auto

# Windows-centric scripts stay CRLF so they run when double-clicked.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source and text — explicit LF.
*.cs    text eol=lf
*.xaml  text eol=lf
*.csproj text eol=lf
*.sln   text eol=crlf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.manifest text eol=lf

# Binary assets — never touch.
*.ico   binary
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary
*.woff2 binary
*.zip   binary
