<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HaCompanion.App.Controls.CategoryFilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    xmlns:controls="using:HaCompanion.App.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Lightweight styling: recolour the ToggleButton "checked" theme keys so a
             selected chip reads as accent-filled. These live in the control's own
             ResourceDictionary (WinUI's Style has no Style.Resources), so every chip
             ToggleButton in this control resolves them via the theme-resource chain. -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.9" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.8" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.9" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.8" />

        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <!-- Wraps chips onto more rows as the window narrows (no horizontal scrolling). -->
    <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <ToggleButton Style="{StaticResource ChipToggle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Click="Chip_Click"
                              AutomationProperties.Name="{Binding Header}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource MdiFont}"
                                  FontSize="14" VerticalAlignment="Center"
                                  Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
