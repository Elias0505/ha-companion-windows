<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="580" Padding="24" HorizontalAlignment="Left">
            <TextBlock Text="Home Assistant" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="Enter your Home Assistant URL and a long-lived access token (Home Assistant → your profile → Long-lived access tokens → Create token)." />

            <TextBox Header="Base URL"
                     PlaceholderText="https://homeassistant.local:8123"
                     Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <PasswordBox Header="Long-lived access token"
                         Password="{x:Bind ViewModel.Token, Mode=TwoWay}" />

            <ToggleSwitch Header="Ignore certificate errors (self-signed HTTPS)"
                          IsOn="{x:Bind ViewModel.IgnoreCertificateErrors, Mode=TwoWay}" />

            <TextBlock Opacity="0.7" FontSize="13"
                       Text="{x:Bind FormatHotkey(ViewModel.Hotkey), Mode=OneWay}" />

            <Button Content="Connect"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveAndConnectCommand}" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.9" />
        </StackPanel>
    </ScrollViewer>
</Page>
