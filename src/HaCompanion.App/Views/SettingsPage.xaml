<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="580" Padding="24" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [Set_Title], Source={StaticResource Loc}}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="{Binding [Set_Intro], Source={StaticResource Loc}}" />

            <TextBox Header="{Binding [Set_BaseUrl], Source={StaticResource Loc}}"
                     PlaceholderText="https://homeassistant.local:8123"
                     Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <PasswordBox x:Name="TokenBox"
                         Header="{Binding [Set_Token], Source={StaticResource Loc}}"
                         PasswordChanged="TokenBox_PasswordChanged" />

            <ToggleSwitch Header="{Binding [Set_IgnoreCert], Source={StaticResource Loc}}"
                          IsOn="{x:Bind ViewModel.IgnoreCertificateErrors, Mode=TwoWay}" />

            <ComboBox Header="{Binding [Set_Language], Source={StaticResource Loc}}"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind ViewModel.Languages}"
                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />

            <ToggleSwitch Header="{Binding [Set_AutoHide], Source={StaticResource Loc}}"
                          IsOn="{x:Bind ViewModel.AutoHideQuickPanel, Mode=TwoWay}" />

            <Slider Header="{Binding [Set_Width], Source={StaticResource Loc}}"
                    Minimum="320" Maximum="900" StepFrequency="20" TickFrequency="0"
                    HorizontalAlignment="Stretch"
                    Value="{x:Bind ViewModel.QuickPanelWidth, Mode=TwoWay}" />

            <ComboBox Header="{Binding [Set_Hotkey], Source={StaticResource Loc}}"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.HotkeyPresets}"
                      SelectedItem="{x:Bind ViewModel.Hotkey, Mode=TwoWay}" />
            <TextBlock Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}" />

            <Expander Header="{Binding [Set_Tips], Source={StaticResource Loc}}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="4,4,4,8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="• Hotkey: use Ctrl or Alt plus a letter (e.g. Ctrl+Alt+H). Windows reserves some Win-key combos (Win+H is voice typing), so those may not register." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="• If a hotkey shows as not registered, another app already uses it — just pick a different combo above." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="• The app keeps running in the system tray (bottom-right, under the ^). Right-click the tray icon → Exit to quit fully; the window close button only hides it." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="• Favourites: use the pencil (edit) button in the quick panel or on Start to add/remove tiles, and drag to reorder." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="• Security: your token is stored encrypted (DPAPI) on this PC only. Enable 'Ignore certificate errors' only for a self-signed local HA; leave it off when using a real certificate/domain." />
                </StackPanel>
            </Expander>

            <Button Content="{Binding [Set_Connect], Source={StaticResource Loc}}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind IsNotBusy(ViewModel.IsBusy), Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveAndConnectCommand}" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.9" />
        </StackPanel>
    </ScrollViewer>
</Page>
