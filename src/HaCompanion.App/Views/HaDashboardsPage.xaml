<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.HaDashboardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Native header: dashboard picker + reload -->
        <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [Nav_Dashboards], Source={StaticResource Loc}}"
                       Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="DashboardCombo" MinWidth="220"
                      AutomationProperties.Name="{Binding [Nav_Dashboards], Source={StaticResource Loc}}"
                      DisplayMemberPath="Title" SelectionChanged="DashboardCombo_SelectionChanged"
                      VerticalAlignment="Center" />
            <Button Grid.Column="3" Padding="8" Click="Reload_Click"
                    ToolTipService.ToolTip="{Binding [Dash_Reload], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [Dash_Reload], Source={StaticResource Loc}}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" x:Name="Info" Margin="16,0,16,8" IsOpen="False" IsClosable="True" />

        <!-- Web content manages its own reading direction (HA has RTL built in) —
             mirroring the host element would double-flip it under Arabic UI. -->
        <controls:WebView2 Grid.Row="2" x:Name="Web" FlowDirection="LeftToRight" />
    </Grid>
</Page>
