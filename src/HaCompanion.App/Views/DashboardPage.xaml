<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    xmlns:hc="using:HaCompanion.App.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:StateBrushConverter x:Key="StateBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*" Padding="24" x:Name="PageRoot">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [Nav_Start], Source={StaticResource Loc}}" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="8,2"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock Text="{Binding Shell.StatusText}" FontSize="12" Opacity="0.8" />
            </Border>

            <Button Grid.Column="3" x:Name="AddTileButton" Padding="8"
                    ToolTipService.ToolTip="{Binding [Tip_Add], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [Tip_Add], Source={StaticResource Loc}}"
                    Visibility="{Binding Catalog.IsEditing, Converter={StaticResource BoolToVisibility}}"
                    Click="AddTileButton_Click">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320" Spacing="8">
                            <TextBox x:Name="SearchBox" PlaceholderText="{Binding [Ph_Search], Source={StaticResource Loc}}"
                                     TextChanged="SearchBox_TextChanged" />
                            <ListView x:Name="SearchResults" MaxHeight="360"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="SearchResult_ItemClick"
                                      ItemsSource="{Binding Catalog.AddCandidates}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                                      FontFamily="{StaticResource MdiFont}" Opacity="0.8"
                                                      VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.55" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="4" x:Name="EditButton" Padding="8"
                    ToolTipService.ToolTip="{Binding [Tip_Edit], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [Tip_Edit], Source={StaticResource Loc}}" Click="EditButton_Click">
                <FontIcon x:Name="EditIcon" Glyph="&#xE70F;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1">
            <StackPanel Spacing="24">
                <TextBlock Text="{Binding [Start_Empty], Source={StaticResource Loc}}"
                           Opacity="0.6" TextWrapping="Wrap"
                           Visibility="{Binding Catalog.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <!-- Favourites -->
                <StackPanel Spacing="10"
                            Visibility="{Binding Catalog.ShowPinnedArea, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE735;" FontSize="15" Opacity="0.85" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Fav_Title], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [Fav_Empty], Source={StaticResource Loc}}"
                               Opacity="0.55" TextWrapping="Wrap"
                               Visibility="{Binding Catalog.ShowEditHint, Converter={StaticResource BoolToVisibility}}" />
                    <hc:VariableTileGridView x:Name="PinnedGrid"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding Catalog.Pinned}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="Pinned_ItemClick"
                              CanDragItems="{Binding Catalog.IsEditing}"
                              AllowDrop="{Binding Catalog.IsEditing}"
                              DragItemsStarting="PinnedGrid_DragItemsStarting"
                              DragItemsCompleted="PinnedGrid_DragItemsCompleted"
                              DragOver="PinnedGrid_DragOver"
                              Drop="PinnedGrid_Drop">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="116" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3"
                                      AutomationProperties.Name="{Binding FriendlyName}"
                                      AutomationProperties.HelpText="{Binding StateText}">
                    <Grid.ContextFlyout>
                        <Flyout Placement="Bottom" Opening="TileFlyout_Opening">
                            <StackPanel Width="240" Spacing="10">
                                <StackPanel Spacing="4"
                                            Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding [Fly_Brightness], Source={StaticResource Loc}}"
                                               FontSize="12" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                            Value="{Binding BrightnessPct, Mode=OneWay}"
                                            ValueChanged="BrightnessSlider_ValueChanged" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding HasClimate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding [Fly_Temp], Source={StaticResource Loc}}"
                                               FontSize="12" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="&#x2212;" Width="40" Click="TempDown_Click" />
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                                            <Run Text="{Binding TargetTemp}" /><Run Text="°" />
                                        </TextBlock>
                                        <Button Content="+" Width="40" Click="TempUp_Click" />
                                        <TextBlock Text="{Binding CurrentTempText}" Opacity="0.6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                                    <Button HorizontalAlignment="Stretch" Click="PlayPause_Click"
                                            Content="{Binding [Fly_PlayPause], Source={StaticResource Loc}}" />
                                    <TextBlock Text="{Binding [Fly_Volume], Source={StaticResource Loc}}"
                                               FontSize="12" Opacity="0.7" />
                                    <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                            Value="{Binding VolumePct, Mode=OneWay}"
                                            ValueChanged="VolumeSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Grid.ContextFlyout>
                                    <Border CornerRadius="10" Padding="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="7" VerticalAlignment="Top">
                                            <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Left"
                                                    Background="{Binding IsOn, Converter={StaticResource StateBrush}}">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="19"
                                                          FontFamily="{StaticResource MdiFont}"
                                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </Border>
                                    <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=PageRoot, Converter={StaticResource BoolToVisibility}}"
                                            Click="Unpin_Click" ToolTipService.ToolTip="{Binding [Tip_Remove], Source={StaticResource Loc}}"
                                            AutomationProperties.Name="{Binding [Tip_Remove], Source={StaticResource Loc}}">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                    <hc:CornerGrip Width="30" Height="30" CornerRadius="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=PageRoot, Converter={StaticResource BoolToVisibility}}"
                                            ToolTipService.ToolTip="{Binding [Tip_Resize], Source={StaticResource Loc}}"
                                            AutomationProperties.Name="{Binding [Tip_Resize], Source={StaticResource Loc}}"
                                            PointerPressed="ResizeGripTile_PointerPressed"
                                            PointerMoved="ResizeGripTile_PointerMoved"
                                            PointerReleased="ResizeGripTile_PointerReleased"
                                            PointerCaptureLost="ResizeGripTile_PointerCaptureLost">
                                        <FontIcon Glyph="&#xE740;" FontSize="10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </hc:CornerGrip>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </hc:VariableTileGridView>
                </StackPanel>

                <!-- All devices, auto-grouped. Deliberately non-virtualizing (ItemsControl):
                     nested ItemsRepeaters inside a StackPanel can only ESTIMATE the total
                     height, which made the scroll position jump/flicker near the bottom. -->
                <ItemsControl ItemsSource="{Binding Catalog.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="10" Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource MdiFont}"
                                              FontSize="16" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Border CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Count}" FontSize="12" Opacity="0.7" />
                                    </Border>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="174" ItemHeight="106" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,10,10">
                                                <Button Command="{Binding ToggleCommand}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                                        Padding="14" CornerRadius="10"
                                                        AutomationProperties.Name="{Binding FriendlyName}"
                                                        AutomationProperties.HelpText="{Binding StateText}">
                                                    <StackPanel Spacing="6">
                                                        <FontIcon Glyph="{Binding IconGlyph}"
                                                                  FontFamily="{StaticResource MdiFont}"
                                                                  FontSize="22" HorizontalAlignment="Left"
                                                                  Foreground="{Binding IsOn, Converter={StaticResource StateBrush}}" />
                                                        <TextBlock Text="{Binding FriendlyName}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{Binding StateText}"
                                                                   FontSize="12" Opacity="0.7"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="32" Height="32" Padding="0" CornerRadius="16"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=PageRoot, Converter={StaticResource BoolToVisibility}}"
                                                        Click="Pin_Click" ToolTipService.ToolTip="{Binding [Tip_Pin], Source={StaticResource Loc}}"
                                                        AutomationProperties.Name="{Binding [Tip_Pin], Source={StaticResource Loc}}">
                                                    <FontIcon Glyph="&#xE718;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
