<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.MyPcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    xmlns:vm="using:HaCompanion.App.ViewModels"
    xmlns:svc="using:HaCompanion.App.Services"
    xmlns:hc="using:HaCompanion.App.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="1400" Padding="24" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding [Nav_MyPc], Source={StaticResource Loc}}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <!-- ===== live status card ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="10" Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [Pc_Status], Source={StaticResource Loc}}"
                               FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                    <TextBlock Text="{x:Bind ViewModel.StatusLine1, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusLine2, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </Border>

            <!-- ===== notify rules: "benachrichtige mich, wenn ..." ===== -->
            <TextBlock Text="{Binding [Nr_Title], Source={StaticResource Loc}}"
                       Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="EntityBox" Grid.Column="0"
                                PlaceholderText="{Binding [Au_PickEntity], Source={StaticResource Loc}}"
                                TextChanged="EntityBox_TextChanged"
                                SuggestionChosen="EntityBox_SuggestionChosen"
                                QuerySubmitted="EntityBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                          FontFamily="{StaticResource MdiFont}" Opacity="0.8"
                                          VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.55" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox Grid.Column="1" MinWidth="190"
                          ItemsSource="{x:Bind ViewModel.Modes}"
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotifyModeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                        Content="{Binding [Au_Add], Source={StaticResource Loc}}"
                        IsEnabled="{Binding CanAddRule}"
                        Command="{Binding AddRuleCommand}" />
            </Grid>

            <!-- Browse devices by category to pick the rule's entity without knowing its name. -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="{Binding [Browse_Title], Source={StaticResource Loc}}">
                <hc:DeviceBrowser DataContext="{Binding Browser}"
                                  HintText="{Binding [Browse_HintPick], Source={StaticResource Loc}}"
                                  EntityInvoked="Browse_EntityInvoked" />
            </Expander>

            <TextBlock Text="{Binding [Nr_Empty], Source={StaticResource Loc}}"
                       Opacity="0.55" TextWrapping="Wrap"
                       Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotifyRuleItemViewModel">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                          FontSize="17" Opacity="0.9" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FriendlyName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ModeText}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                          Toggled="RuleToggle_Toggled" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="16"
                                    VerticalAlignment="Center" Click="RemoveRule_Click"
                                    ToolTipService.ToolTip="{Binding [Tip_Remove], Source={StaticResource Loc}}"
                                    AutomationProperties.Name="{Binding [Tip_Remove], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== HA -> PC commands ===== -->
            <TextBlock Text="{Binding [Cmd_Title], Source={StaticResource Loc}}"
                       Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap">
                <Run Text="{Binding [Cmd_Hint], Source={StaticResource Loc}}" />
                <Run Text="{x:Bind ViewModel.NotifyServiceName}" FontFamily="Consolas" />
            </TextBlock>
            <TextBlock Text="{Binding [Cmd_NeedsDevice], Source={StaticResource Loc}}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Visibility="{x:Bind ViewModel.ShowDeviceHint, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding [Cmd_HttpWarn], Source={StaticResource Loc}}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Visibility="{x:Bind ViewModel.ShowHttpWarning, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="74" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ToggleSwitch Header="{Binding [Cmd_command_lock], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowLock, Mode=TwoWay}" OnContent="" OffContent="" />
                <ToggleSwitch Header="{Binding [Cmd_command_monitor_off], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowMonitorOff, Mode=TwoWay}" OnContent="" OffContent="" />
                <ToggleSwitch Header="{Binding [Cmd_command_volume], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowVolume, Mode=TwoWay}" OnContent="" OffContent="" />
                <ToggleSwitch Header="{Binding [Cmd_command_sleep], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowSleep, Mode=TwoWay}" OnContent="" OffContent="" />
                <ToggleSwitch Header="{Binding [Cmd_command_shutdown], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowShutdown, Mode=TwoWay}" OnContent="" OffContent="" />
                <ToggleSwitch Header="{Binding [Cmd_command_launch], Source={StaticResource Loc}}"
                              IsOn="{Binding AllowLaunch, Mode=TwoWay}" OnContent="" OffContent="" />
            </ItemsControl>

            <TextBox Header="{Binding [Cmd_Whitelist], Source={StaticResource Loc}}"
                     Text="{Binding LaunchWhitelistText, Mode=TwoWay}"
                     Visibility="{Binding AllowLaunch, Converter={StaticResource BoolToVisibility}}" />

            <!-- ===== received history ===== -->
            <TextBlock Text="{Binding [Rx_Title], Source={StaticResource Loc}}"
                       Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding [Rx_Empty], Source={StaticResource Loc}}"
                       Opacity="0.55" TextWrapping="Wrap" x:Name="RxEmptyText" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:ReceivedItem">
                        <Grid ColumnSpacing="10" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" FontSize="12" Opacity="0.5"
                                       VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE7E8;" FontSize="11" Opacity="0.7"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind IsCommand, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Column="2" FontSize="13" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                <Run Text="{x:Bind Title}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{x:Bind Message}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
