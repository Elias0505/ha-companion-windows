<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HaCompanion.App.Views.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="1400" Padding="24" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding [Nav_Shortcuts], Source={StaticResource Loc}}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding [Sc_Intro], Source={StaticResource Loc}}"
                       Opacity="0.7" TextWrapping="Wrap" />

            <!-- Add row: entity search + record keys + add -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="EntityBox" Grid.Column="0"
                                PlaceholderText="{Binding [Sc_PickEntity], Source={StaticResource Loc}}"
                                TextChanged="EntityBox_TextChanged"
                                SuggestionChosen="EntityBox_SuggestionChosen"
                                QuerySubmitted="EntityBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                          FontFamily="{StaticResource MdiFont}" Opacity="0.8"
                                          VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.55" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <Button x:Name="RecordButton" Grid.Column="1" MinWidth="140"
                        Click="RecordButton_Click"
                        KeyDown="RecordButton_KeyDown"
                        LostFocus="RecordButton_LostFocus" />

                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                        Content="{Binding [Sc_Add], Source={StaticResource Loc}}"
                        IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
                        Click="AddButton_Click" />
            </Grid>

            <!-- Existing shortcuts -->
            <TextBlock Text="{Binding [Sc_Empty], Source={StaticResource Loc}}"
                       Opacity="0.55" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                          FontSize="17" Opacity="0.9" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EntityId}" FontSize="11" Opacity="0.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding [Sc_InUse], Source={StaticResource Loc}}"
                                           FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Hotkey}" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <Button Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="16"
                                    VerticalAlignment="Center" Click="Remove_Click"
                                    ToolTipService.ToolTip="{Binding [Tip_Remove], Source={StaticResource Loc}}"
                                    AutomationProperties.Name="{Binding [Tip_Remove], Source={StaticResource Loc}}">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Quick pick: all devices grouped by category (same sections as the start page);
                 tapping one selects it for the new shortcut. -->
            <TextBlock Text="{Binding [Sc_Browse], Source={StaticResource Loc}}"
                       Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <!-- Non-virtualizing on purpose — see the start page's browse list. -->
            <ItemsControl ItemsSource="{Binding Catalog.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="8" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource MdiFont}"
                                          FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" Opacity="0.9" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="202" ItemHeight="42" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Margin="0,0,6,6"
                                                Padding="10,7" Click="QuickPick_Click"
                                                AutomationProperties.Name="{Binding FriendlyName}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                                          FontSize="15" Opacity="0.85" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
