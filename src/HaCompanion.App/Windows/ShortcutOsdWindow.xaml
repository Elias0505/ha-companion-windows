<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaCompanion.App.Windows.ShortcutOsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Padding="16,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconCircle" Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                VerticalAlignment="Center">
            <FontIcon x:Name="OsdIcon" FontFamily="{StaticResource MdiFont}" FontSize="19"
                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="OsdTitle" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="OsdSubtitle" FontSize="12" Opacity="0.6"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>
    </Grid>
</Window>
