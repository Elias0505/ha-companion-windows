<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaCompanion.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:hc="using:HaCompanion.App.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <conv:StateBrushConverter x:Key="StateBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Shared between the flat favourites grid and the per-category grids -->
            <ItemsPanelTemplate x:Key="TileCellsPanel">
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="112" ItemHeight="108" />
            </ItemsPanelTemplate>
            <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <DataTemplate x:Key="TileTemplate">
                <Grid Margin="3"
                      AutomationProperties.Name="{Binding FriendlyName}"
                      AutomationProperties.HelpText="{Binding StateText}">
                <Grid.ContextFlyout>
                    <Flyout Placement="Bottom" Opening="TileFlyout_Opening">
                        <StackPanel Width="240" Spacing="10">
                            <StackPanel Spacing="4"
                                        Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding [Fly_Brightness], Source={StaticResource Loc}}"
                                           FontSize="12" Opacity="0.7" />
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{Binding BrightnessPct, Mode=OneWay}"
                                        ValueChanged="BrightnessSlider_ValueChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4"
                                        Visibility="{Binding HasClimate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding [Fly_Temp], Source={StaticResource Loc}}"
                                           FontSize="12" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="&#x2212;" Width="40" Click="TempDown_Click" />
                                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                                        <Run Text="{Binding TargetTemp}" /><Run Text="°" />
                                    </TextBlock>
                                    <Button Content="+" Width="40" Click="TempUp_Click" />
                                    <TextBlock Text="{Binding CurrentTempText}" Opacity="0.6" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="4"
                                        Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                                <Button HorizontalAlignment="Stretch" Click="PlayPause_Click"
                                        Content="{Binding [Fly_PlayPause], Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding [Fly_Volume], Source={StaticResource Loc}}"
                                           FontSize="12" Opacity="0.7" />
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{Binding VolumePct, Mode=OneWay}"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Grid.ContextFlyout>
                    <Border CornerRadius="10" Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6" VerticalAlignment="Top">
                            <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left"
                                    Background="{Binding IsOn, Converter={StaticResource StateBrush}}">
                                <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                          FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding FriendlyName}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Border>
                    <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=RootGrid, Converter={StaticResource BoolToVisibility}}"
                            Click="Unpin_Click" ToolTipService.ToolTip="{Binding [Tip_Remove], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding [Tip_Remove], Source={StaticResource Loc}}">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                    <hc:CornerGrip Width="30" Height="30" CornerRadius="15"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=RootGrid, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{Binding [Tip_Resize], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding [Tip_Resize], Source={StaticResource Loc}}"
                            PointerPressed="ResizeGripTile_PointerPressed"
                            PointerMoved="ResizeGripTile_PointerMoved"
                            PointerReleased="ResizeGripTile_PointerReleased"
                            PointerCaptureLost="ResizeGripTile_PointerCaptureLost">
                        <FontIcon Glyph="&#xE740;" FontSize="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </hc:CornerGrip>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnLauncherAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid x:Name="PanelSurface" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Padding="16,14,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding Shell.IsConnected, Converter={StaticResource StateBrush}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{Binding [Panel_Header], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding Shell.StatusText}" FontSize="11" Opacity="0.6" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding ShowFavorites, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="LauncherButton" Padding="8"
                            ToolTipService.ToolTip="{Binding [Panel_SearchPh], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding [Panel_SearchPh], Source={StaticResource Loc}}">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout x:Name="LauncherFlyout" Placement="Bottom" Opened="LauncherFlyout_Opened">
                                <AutoSuggestBox x:Name="LauncherBox" Width="280"
                                                PlaceholderText="{Binding [Panel_SearchPh], Source={StaticResource Loc}}"
                                                QueryIcon="Find"
                                                TextChanged="LauncherBox_TextChanged"
                                                QuerySubmitted="LauncherBox_QuerySubmitted">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                                          FontFamily="{StaticResource MdiFont}" Opacity="0.8"
                                                          VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.55" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton Padding="8" IsChecked="{Binding SortByCategory, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{Binding [Tip_SortCategory], Source={StaticResource Loc}}"
                                  AutomationProperties.Name="{Binding [Tip_SortCategory], Source={StaticResource Loc}}">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    </ToggleButton>
                    <Button x:Name="AddTileButton" Padding="8" ToolTipService.ToolTip="{Binding [Tip_Add], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding [Tip_Add], Source={StaticResource Loc}}"
                            Click="AddTileButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="300" Spacing="8">
                                    <TextBox x:Name="SearchBox" PlaceholderText="{Binding [Ph_Search], Source={StaticResource Loc}}"
                                             TextChanged="SearchBox_TextChanged" />
                                    <ListView x:Name="SearchResults" MaxHeight="320"
                                              SelectionMode="None" IsItemClickEnabled="True"
                                              ItemClick="SearchResult_ItemClick"
                                              ItemsSource="{Binding Catalog.AddCandidates}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                                              FontFamily="{StaticResource MdiFont}" Opacity="0.8"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.55" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="EditButton" Padding="8" ToolTipService.ToolTip="{Binding [Tip_Edit], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding [Tip_Edit], Source={StaticResource Loc}}" Click="EditButton_Click">
                        <FontIcon x:Name="EditIcon" Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dashboard picker + pin-as-default -->
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{Binding [Nav_Dashboards], Source={StaticResource Loc}}"
                          ItemsSource="{Binding Dashboards}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedDashboard, Mode=TwoWay}" />
                <ToggleButton Grid.Column="1" Padding="8" VerticalAlignment="Stretch"
                              IsChecked="{Binding IsDefaultView, Mode=TwoWay}"
                              ToolTipService.ToolTip="{Binding [Tip_PinDefault], Source={StaticResource Loc}}"
                              AutomationProperties.Name="{Binding [Tip_PinDefault], Source={StaticResource Loc}}">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="2">
                <!-- Favourites: manually pinned tiles only (no auto-populate) -->
                <Grid Visibility="{Binding ShowFavorites, Converter={StaticResource BoolToVisibility}}">
                    <!-- Manual order: one free-form grid; tiles rearrange live while dragging -->
                    <Grid Visibility="{Binding SortByCategory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <hc:VariableTileGridView x:Name="PinnedGrid"
                                  Visibility="{Binding Catalog.HasPinned, Converter={StaticResource BoolToVisibility}}"
                                  ItemsSource="{Binding Catalog.Pinned}"
                                  ItemTemplate="{StaticResource TileTemplate}"
                                  ItemContainerStyle="{StaticResource TileContainerStyle}"
                                  ItemsPanel="{StaticResource TileCellsPanel}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Pinned_ItemClick"
                                  CanDragItems="{Binding Catalog.IsEditing}"
                                  AllowDrop="{Binding Catalog.IsEditing}"
                                  DragItemsStarting="PinnedGrid_DragItemsStarting"
                                  DragItemsCompleted="PinnedGrid_DragItemsCompleted"
                                  DragOver="PinnedGrid_DragOver"
                                  Drop="PinnedGrid_Drop" />
                    </Grid>

                    <!-- Category mode: named sections, same titles/order as the start page -->
                    <ScrollViewer x:Name="GroupScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SortByCategory, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PinnedGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="6" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource MdiFont}"
                                                      FontSize="13" Opacity="0.8" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" Opacity="0.9" />
                                        </StackPanel>
                                        <hc:VariableTileGridView
                                                  ItemsSource="{Binding Tiles}"
                                                  ItemTemplate="{StaticResource TileTemplate}"
                                                  ItemContainerStyle="{StaticResource TileContainerStyle}"
                                                  ItemsPanel="{StaticResource TileCellsPanel}"
                                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Pinned_ItemClick"
                                                  ScrollViewer.VerticalScrollMode="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding [Panel_NoTiles], Source={StaticResource Loc}}"
                               Opacity="0.55" TextWrapping="Wrap" Margin="4,8,4,0" VerticalAlignment="Top"
                               Visibility="{Binding Catalog.ShowNoFavHint, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Selected HA dashboard: real HA frontend 1:1, chrome hidden -->
                <controls:WebView2 x:Name="PanelWeb"
                                   Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- Drag handle on the inner (left) edge: drag to change the panel width live.
             Hidden when disabled in Settings (QuickPanelDragResize). -->
        <hc:ResizeGrip x:Name="ResizeGrip" Width="12" Background="Transparent"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch"
                       PointerPressed="ResizeGrip_PointerPressed"
                       PointerMoved="ResizeGrip_PointerMoved"
                       PointerReleased="ResizeGrip_PointerReleased"
                       PointerCaptureLost="ResizeGrip_PointerCaptureLost">
            <Border Width="4" Height="48" CornerRadius="2" Opacity="0.45"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        </hc:ResizeGrip>
    </Grid>
</Window>
