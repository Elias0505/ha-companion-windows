<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaCompanion.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:StateBrushConverter x:Key="StateBrush" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>

        <Grid Padding="16" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Home Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Grid.Row="1" Text="{Binding Shell.StatusText}"
                       Opacity="0.7" FontSize="12" Margin="0,0,0,4" />

            <ScrollViewer Grid.Row="2">
                <ItemsRepeater ItemsSource="{Binding Catalog.Tiles}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="110" MinItemHeight="92"
                                           MinColumnSpacing="8" MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ToggleCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="12" CornerRadius="10">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="{Binding Glyph}"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="20" HorizontalAlignment="Left"
                                              Foreground="{Binding IsOn, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding FriendlyName}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <TextBlock Text="{Binding StateText}"
                                               FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
