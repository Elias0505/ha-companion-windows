<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaCompanion.App.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HaCompanion.App.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <conv:StateBrushConverter x:Key="StateBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Shared read-only tile card (icon circle + name + state) -->
            <DataTemplate x:Key="TileCard">
                <Border Width="108" Height="104" Margin="2" CornerRadius="10" Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left"
                                Background="{Binding IsOn, Converter={StaticResource StateBrush}}">
                            <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                      FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding FriendlyName}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>

        <Grid Padding="16,14,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding Shell.IsConnected, Converter={StaticResource StateBrush}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{Binding [Panel_Header], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding Shell.StatusText}" FontSize="11" Opacity="0.6" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding ShowFavorites, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="AddTileButton" Padding="8" ToolTipService.ToolTip="{Binding [Tip_Add], Source={StaticResource Loc}}"
                            Visibility="{Binding Catalog.IsEditing, Converter={StaticResource BoolToVisibility}}"
                            Click="AddTileButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="300" Spacing="8">
                                    <TextBox x:Name="SearchBox" PlaceholderText="{Binding [Ph_Search], Source={StaticResource Loc}}"
                                             TextChanged="SearchBox_TextChanged" />
                                    <ListView x:Name="SearchResults" MaxHeight="320"
                                              SelectionMode="None" IsItemClickEnabled="True"
                                              ItemClick="SearchResult_ItemClick"
                                              ItemsSource="{Binding Catalog.AddCandidates}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="15"
                                                              FontFamily="{StaticResource MdiFont}" Opacity="0.8" />
                                                    <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="EditButton" Padding="8" ToolTipService.ToolTip="{Binding [Tip_Edit], Source={StaticResource Loc}}" Click="EditButton_Click">
                        <FontIcon x:Name="EditIcon" Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dashboard picker -->
            <ComboBox Grid.Row="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Dashboards}"
                      DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedDashboard, Mode=TwoWay}" />

            <!-- Content -->
            <Grid Grid.Row="2">
                <!-- Favourites (editable pinned + grouped browse fallback) -->
                <Grid Visibility="{Binding ShowFavorites, Converter={StaticResource BoolToVisibility}}">
                    <GridView x:Name="PinnedGrid"
                              Visibility="{Binding Catalog.ShowPinnedArea, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding Catalog.Pinned}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="Pinned_ItemClick"
                              CanDragItems="{Binding Catalog.IsEditing}"
                              CanReorderItems="{Binding Catalog.IsEditing}"
                              AllowDrop="{Binding Catalog.IsEditing}">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="108" Height="104" Margin="2">
                                    <Border CornerRadius="10" Padding="10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left"
                                                    Background="{Binding IsOn, Converter={StaticResource StateBrush}}">
                                                <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                                          FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </Border>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding DataContext.Catalog.IsEditing, ElementName=RootGrid, Converter={StaticResource BoolToVisibility}}"
                                            Click="Unpin_Click" ToolTipService.ToolTip="{Binding [Tip_Remove], Source={StaticResource Loc}}">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock Text="{Binding [Panel_NoTiles], Source={StaticResource Loc}}"
                               Opacity="0.55" TextWrapping="Wrap" Margin="4,8,4,0"
                               Visibility="{Binding Catalog.ShowEditHint, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer Visibility="{Binding Catalog.ShowBrowse, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater ItemsSource="{Binding Catalog.Groups}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{Binding Glyph}" FontFamily="{StaticResource MdiFont}"
                                                      FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Count}" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsRepeater ItemsSource="{Binding Tiles}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="110" MinItemHeight="92"
                                                                   MinColumnSpacing="8" MinRowSpacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding ToggleCommand}"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Padding="12" CornerRadius="10">
                                                        <StackPanel Spacing="4">
                                                            <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource MdiFont}"
                                                                      FontSize="20" HorizontalAlignment="Left"
                                                                      Foreground="{Binding IsOn, Converter={StaticResource StateBrush}}" />
                                                            <TextBlock Text="{Binding FriendlyName}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.7"
                                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>

                <!-- Selected HA dashboard: real HA frontend 1:1, chrome hidden -->
                <controls:WebView2 x:Name="PanelWeb"
                                   Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
